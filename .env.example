# Local Compose configuration. Copy to .env with mode 600; never commit .env.
# Values are literal (raw env_file): no shell quotes, expansion or inline comments.
# Both background workers stay off until you explicitly enable them.
BERLIN_TRANSIT_COLLECTOR_ENABLED=false
BERLIN_TRANSIT_COLLECTOR_STATIONS=900135001
BERLIN_TRANSIT_COLLECTOR_INTERVAL=30s
BERLIN_TRANSIT_COLLECTOR_MODE=suburban
BERLIN_TRANSIT_COLLECTOR_LIMIT=8
BERLIN_TRANSIT_REQUESTS_PER_MINUTE=30
BERLIN_TRANSIT_LOG_LEVEL=info
TRMNL_ENABLED=false
TRMNL_WEBHOOK_URL=
TRMNL_INTERVAL=5m
TRMNL_MAX_DEPARTURES=8
